#!name=YouTube
#!desc=2025-12-05 00:32:12
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1067.png
#!arguments-desc=\n 参数说明：\n YouTube翻译语言：默认关闭，填入zh-Hans开启；\n

[Argument]
blockUpload = switch, true, false, tag = 隐藏上传按钮, desc = 用于隐藏YouTube底栏的上传按钮
blockShorts = switch, true, false, tag = 隐藏Shorts按钮, desc = 用于隐藏YouTube底栏的Shorts按钮
blockImmersive = switch, true, false, tag = 隐藏选段按钮, desc = 用于隐藏YouTube Music底栏的选段按钮
captionLang = select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag = 字幕翻译语言, desc = 选择翻译为何种语言字幕
lyricLang = select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag = 歌词翻译语言, desc = 选择翻译为何种语言字幕
debug = switch, false, true, tag = 启用调试模式, desc = 此插件的调试模式

[Rule]
AND, ((DOMAIN-SUFFIX, googlevideo.com),  (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, youtubei.googleapis.com),  (PROTOCOL, QUIC)), REJECT

[Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad - reject-200

[Script]
http-response ^https?:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$ script-path=https://raw.githubusercontent.com/TimKerry/Script/refs/heads/main/youtube_adblock.js, requires-body=true, binary-body-mode=true, tag=youtube.response, argument="{"lyricLang":"{YouTube ·歌词翻译语言}","captionLang":"{YouTube ·字幕翻译语言}","blockUpload":{YouTube ·屏蔽上传按钮},"blockImmersive":{YouTube ·屏蔽选段按钮},"blockShorts":{YouTube ·屏蔽短片按钮},"debug":false}"

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com
